#!/usr/bin/env bash
# Pre-commit hook: Semgrep scan on staged files with automatic CodeMender integration
set -uo pipefail

BUDGET="${CM_HOOK_BUDGET:-10}"
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
RULES="${CM_HOOK_RULES:-$ROOT/.cm/rules}"

ok() { exit 0; }

[ "${CM_HOOK_SKIP:-0}" = "1" ] && ok
command -v semgrep >/dev/null 2>&1 || { echo "cm-hook: semgrep not installed — skipping (fail-open)"; ok; }

# Staged source files only
mapfile -d '' -t STAGED < <(git diff --cached --name-only --diff-filter=ACMR -z -- \
  '*.js' '*.jsx' '*.ts' '*.tsx' '*.py' '*.go' '*.java' 2>/dev/null)
[ ${#STAGED[@]} -eq 0 ] && ok

TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
FILES=()
for f in "${STAGED[@]}"; do
  [ -n "$f" ] || continue
  mkdir -p "$TMP/$(dirname "$f")"
  git show ":$f" > "$TMP/$f" 2>/dev/null && FILES+=("$TMP/$f")
done
[ ${#FILES[@]} -eq 0 ] && ok

ARGS=(--metrics=off --quiet --json --disable-version-check --timeout 5)
[ -d "$RULES" ] && ARGS+=(--config "$RULES")
ARGS+=(--config p/javascript)

OUT="$TMP/semgrep.json"
timeout "$BUDGET" semgrep scan "${ARGS[@]}" -o "$OUT" "${FILES[@]}" >/dev/null 2>"$TMP/err"
RC=$?
if [ $RC -ne 0 ]; then
  if [ $RC -eq 124 ]; then
    echo "cm-hook: over ${BUDGET}s budget — skipped (fail-open)"
  else
    echo "cm-hook: semgrep exited $RC — skipped (fail-open)"
  fi
  ok
fi
[ -s "$OUT" ] || ok

python3 - "$OUT" "$TMP" "$ROOT" <<'PY'
import json, sys, os, subprocess

out, tmp, root = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    res = json.load(open(out)).get("results", [])
except Exception:
    sys.exit(0)

if not res:
    sys.exit(0)

def rel(p): return os.path.relpath(p, tmp)

W, R, B, D = "\033[33m", "\033[31m", "\033[1m", "\033[0m"

print(f"\n{W}{B}⚠️  cm-hook: Semgrep detected {len(res)} potential security finding(s) in staged files:{D}")
for r in res[:5]:
    rule = r.get("check_id", "finding").rsplit(".", 1)[-1]
    path = rel(r.get("path", ""))
    line = (r.get("start") or {}).get("line", 0)
    print(f"   {W}• {path}:{line}{D} -> {rule}")

print(f"\n{B}💡 Pro-tip:{D} Convert and fix these findings locally using CodeMender before committing:")
print(f"   1. python3 lab/scripts/semgrep-to-cm.py semgrep.json -o cm-findings.json")
print(f"   2. cm report import -f cm-findings.json -p .")
print(f"   3. cm fix <finding_id> -y")
print(f"   (Bypass this advisory hook with: {B}git commit --no-verify{D})\n")

sys.exit(0)
PY
