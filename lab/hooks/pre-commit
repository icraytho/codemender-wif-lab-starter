#!/usr/bin/env bash
# Pre-commit hook: Fast Semgrep scan on staged files (fails-open)
set -uo pipefail

BUDGET="${CM_HOOK_BUDGET:-10}"
ok() { exit 0; }

[ "${CM_HOOK_SKIP:-0}" = "1" ] && ok
command -v semgrep >/dev/null 2>&1 || ok

# Staged JavaScript/TypeScript source files only
mapfile -d '' -t STAGED < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.js' '*.ts' 2>/dev/null)
[ ${#STAGED[@]} -eq 0 ] && ok

TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
FILES=()
for f in "${STAGED[@]}"; do
  [ -n "$f" ] || continue
  mkdir -p "$TMP/$(dirname "$f")"
  git show ":$f" > "$TMP/$f" 2>/dev/null && FILES+=("$TMP/$f")
done
[ ${#FILES[@]} -eq 0 ] && ok

OUT="$TMP/semgrep.json"
timeout "$BUDGET" semgrep scan --config p/javascript --metrics=off --quiet --json --disable-version-check -o "$OUT" "${FILES[@]}" >/dev/null 2>&1 || ok
[ -s "$OUT" ] || ok

python3 - "$OUT" "$TMP" <<'PY'
import json, sys, os

out, tmp = sys.argv[1], sys.argv[2]
try:
    res = json.load(open(out)).get("results", [])
except Exception:
    sys.exit(0)

if not res:
    sys.exit(0)

def rel(p): return os.path.relpath(p, tmp)

W, B, D = "\033[33m", "\033[1m", "\033[0m"
print(f"\n{W}{B}⚠️  cm-hook: Semgrep detected {len(res)} potential finding(s) in staged files:{D}")
for r in res[:5]:
    rule = r.get("check_id", "finding").rsplit(".", 1)[-1]
    path = rel(r.get("path", ""))
    line = (r.get("start") or {}).get("line", 0)
    print(f"   {W}• {path}:{line}{D} -> {rule}")

print(f"\n{B}💡 Remediate locally with CodeMender before committing:{D}")
print(f"   python3 lab/scripts/semgrep-to-cm.py semgrep.json -o cm-findings.json")
print(f"   cm report import -f cm-findings.json -p .")
print(f"   cm fix 1 -y --bypass-warning\n")

sys.exit(0)
PY
